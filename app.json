{
  "expo": {
    "name": "Rivald'event",
    "slug": "rivaldevent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "rivaldevent",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#F7F4ED"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rivaldevent.app",
      "backgroundColor": "#F7F4ED"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#F7F4ED"
      },
      "package": "com.rivaldevent.app",
      "backgroundColor": "#F7F4ED"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      },
      "router": {
        "origin": false
      }
    },
    "owner": "rivaldevent"
  }
}
