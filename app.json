{
  "expo": {
    "name": "Rivald'event",
    "slug": "rivaldevent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "rivaldevent",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rivaldevent.app",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.rivaldevent.app",
      "backgroundColor": "#FFFFFF"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/images/app-icon.png",
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "@clerk/expo",
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "eas": {
        "projectId": "c97cf7df-f657-4049-a03a-edf166f41f2e"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "riousbrel",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c97cf7df-f657-4049-a03a-edf166f41f2e"
    }
  }
}
